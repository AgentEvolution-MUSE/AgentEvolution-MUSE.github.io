---
import ResultFigure from './ResultFigure.astro';
import ResultTable from './ResultTable.astro';
import ResultTradeoff from './ResultTradeoff.astro';
import SupervisionComparison from './SupervisionComparison.astro';
import JointAdaptationTable from './JointAdaptationTable.astro';
import EvolutionCurves from './EvolutionCurves.astro';
import ExperimentChart from './ExperimentChart.astro';
import CaseStudies from './CaseStudies.astro';
import '../styles/results.css';
const questions = [
  ['rq1', 'RQ1', 'Adaptivity'], ['rq2', 'RQ2', 'Components'],
  ['rq3', 'RQ3', 'Supervision'], ['rq4', 'RQ4', 'Gating'],
  ['rq5', 'RQ5', 'Stability'], ['result-cases', 'Examples', 'Case studies'],
];

---
<section id="results" class="section-band results-band" aria-labelledby="results-title">
  <div class="container">
    <div class="section-intro results-intro">
      <h2 id="results-title" class="section-heading">Experimental Results</h2>
      <details class="results-setup"><summary>Experimental setup</summary>
        <dl>
          <div><dt>Benchmark</dt><dd>APPWorld · Qwen3.5-9B · Up to 8 evolution rounds. Symbolic ablations also use Qwen3.5-27B.</dd></div>
          <div><dt>RQ2 · Components</dt><dd>Oracle tasks only; no synthetic tasks or metacognitive gating.</dd></div>
          <div><dt>RQ3 · Supervision</dt><dd>Prefix-potential supervision; no metacognitive gating.</dd></div>
          <div><dt>RQ4 · Gating</dt><dd>Supplementary supervision and model weight adaptation in every round. Random matches Metacognitive’s symbolic-component counts.</dd></div>
        </dl>
      </details>
    </div>
    <nav class="rq-nav" aria-label="Research questions and case studies">
      {questions.map(([id, number, label], index) => <a href={`#${id}`} data-rq-link style={`--rq-accent: var(--rq-color-${index + 1})`}><span class="rq-nav-number">{number}</span><strong>{label}</strong><span class="rq-nav-line" aria-hidden="true"></span></a>)}
    </nav>

    <section id="rq1" class="rq-section" aria-labelledby="rq1-title">
      <header class="rq-header"><p class="rq-label">RQ1</p>
        <h3 id="rq1-title">Does MUSE improve task success and efficiency?</h3>
      </header>
      <ResultTradeoff />
    </section>

    <section id="rq2" class="rq-section" aria-labelledby="rq2-title">
      <header class="rq-header"><p class="rq-label">RQ2</p>
        <h3 id="rq2-title">Does combining symbolic and parametric updates help?</h3>
      </header>
      <JointAdaptationTable />
      <details class="rq-details"><summary>Symbolic components · 9B / 27B</summary>
        <p>Combined symbolic adaptation gains <strong>6.55 pp at 9B</strong> and <strong>10.71 pp at 27B</strong>. At 9B, the peak improvement from toolset refinement is not sustained across rounds (Evo-AUC −2.64).</p>
        <ResultTable table="symbolic" />
      </details>
    </section>

    <section id="rq3" class="rq-section" aria-labelledby="rq3-title">
      <header class="rq-header"><p class="rq-label">RQ3</p>
        <h3 id="rq3-title">When does supplementary supervision help?</h3>
      </header>
      <SupervisionComparison />
      <details class="rq-details"><summary>Task and reward audits</summary>
        <p>Human audit · One complete MUSE run · 40 candidate tasks (39 assessable), 36 admitted tasks, and 31 guided / 31 free executions.</p>
        <ResultTable table="quality" />
        <ResultTable table="reliability" />
      </details>
      <details class="rq-details"><summary>Synthetic task distribution</summary>
        <p>36 admitted tasks · 4 additional applications · 35 multi-application tasks</p>
        <div class="native-chart-grid">
          <ExperimentChart chart="coverage" />
          <ExperimentChart chart="composition" />
          <ExperimentChart chart="matching" />
          <ExperimentChart chart="pool" />
        </div>
      </details>
    </section>

    <section id="rq4" class="rq-section" aria-labelledby="rq4-title">
      <header class="rq-header"><p class="rq-label">RQ4</p>
        <h3 id="rq4-title">How does metacognitive gating affect performance and cost?</h3>
      </header>
      <div class="native-chart-grid">
        <ExperimentChart chart="rollouts" />
        <ExperimentChart chart="performance" />
      </div>
      <p class="rq-tradeoff">29.15% fewer rollouts than Always-on; higher peak success, lower final success.</p>
      <details class="rq-details"><summary>All gating results</summary>
        <ResultTable table="gating" />
      </details>
      <details id="gating-analysis" class="rq-details"><summary>Gating decisions</summary>
        <ResultFigure asset="metacognitive-gating-case-study.svg" dense enlarge alt="Eight rounds of interaction evidence, capability diagnoses, and component selection in the full MUSE run." caption="Recorded diagnoses and retrospective interpretations connect interaction evidence to selected updates." />
      </details>
    </section>

    <section id="rq5" class="rq-section" aria-labelledby="rq5-title">
      <header class="rq-header"><p class="rq-label">RQ5</p>
        <h3 id="rq5-title">Does performance improve consistently across evolution rounds?</h3>
      </header>
      <EvolutionCurves />
    </section>

    <CaseStudies />
  </div>
</section>
<dialog class="result-lightbox" aria-labelledby="result-lightbox-title">
  <div class="result-lightbox-header"><p id="result-lightbox-title"></p><button type="button" data-close-figure aria-label="Close enlarged figure">Close <span aria-hidden="true">×</span></button></div>
  <div class="result-lightbox-scroll" tabindex="0" role="region" aria-label="Enlarged figure; scroll to inspect"><img alt="" /></div>
</dialog>
<script>
  // Open a linked case before scrolling, including direct visits to its hash.
  function revealResultTarget() {
    const target = document.getElementById(window.location.hash.slice(1));
    if (target instanceof HTMLDetailsElement && target.closest('#results')) target.open = true;
  }
  window.addEventListener('hashchange', revealResultTarget);
  revealResultTarget();

  const dialog = document.querySelector<HTMLDialogElement>('.result-lightbox');
  const enlarged = dialog?.querySelector<HTMLImageElement>('img');
  const title = dialog?.querySelector<HTMLElement>('#result-lightbox-title');
  document.querySelectorAll<HTMLButtonElement>('[data-enlarge-figure]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !enlarged || !title) return;
      enlarged.src = button.dataset.figureSrc ?? '';
      enlarged.alt = button.dataset.figureAlt ?? '';
      title.textContent = button.dataset.figureCaption ?? 'Figure detail';
      dialog.showModal();
      document.documentElement.classList.add('result-zoom-open');
      dialog.querySelector('.result-lightbox-scroll')?.scrollTo(0, 0);
    });
  });
  dialog?.querySelector('[data-close-figure]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', () => document.documentElement.classList.remove('result-zoom-open'));
  dialog?.addEventListener('click', (event) => {
    if (event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
  });
</script>
