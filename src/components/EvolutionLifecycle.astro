---
import { lifecycleStages } from '../data/site';

const descriptions = [
  'Track longitudinal capability evidence during deployment.',
  'Identify capability gaps and determine whether evolution is warranted.',
  'Derive grounded tasks, rewards, and references from interaction.',
  'Route and synchronize updates across selected components.',
  'Measure fitness while preserving validated legacy capabilities.',
];
---

<section
  class="section-band lifecycle-band"
  aria-labelledby="lifecycle-title"
  data-motion-group="lifecycle"
>
  <div class="container section-intro centered-intro">
    <p class="eyebrow">A Continuous Lifecycle</p>
    <h2 id="lifecycle-title" class="section-heading">Evolution in Action</h2>
    <p>Deployment evidence closes the loop between capability assessment and coordinated change.</p>
  </div>

  <ol class="container lifecycle-track">
    {lifecycleStages.map((stage, index) => (
      <li data-lifecycle-stage data-motion-item>
        <span class="stage-number">{String(index + 1).padStart(2, '0')}</span>
        <h3>{stage}</h3>
        <p>{descriptions[index]}</p>
      </li>
    ))}
  </ol>
</section>
