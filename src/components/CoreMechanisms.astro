---
import { mechanisms } from '../data/site';
---

<section id="method" class="section-band method-band" aria-labelledby="method-title">
  <div class="container section-intro">
    <p class="eyebrow">Method</p>
    <h2 id="method-title" class="section-heading">Three Mechanisms for Stage-4 Evolution</h2>
    <p>
      MUSE couples when to evolve, how to generate grounded supervision, and what to
      optimize within one lifecycle rather than treating them as isolated updates.
    </p>
  </div>

  <div class="container mechanism-grid">
    {mechanisms.map((mechanism) => (
      <article class={`mechanism accent-${mechanism.accent}`} data-mechanism>
        <span class="mechanism-index">{mechanism.index}</span>
        <h3>{mechanism.title}</h3>
        <p>{mechanism.text}</p>
      </article>
    ))}
  </div>
</section>
