---
import Architecture from '../components/Architecture.astro';
import EvolutionFormulation from '../components/EvolutionFormulation.astro';
import EvolutionSpectrum from '../components/EvolutionSpectrum.astro';
import Hero from '../components/Hero.astro';
import PageMotion from '../components/PageMotion.astro';
import Resources from '../components/Resources.astro';
import Results from '../components/Results.astro';
import SectionRail from '../components/SectionRail.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WhyEvolve from '../components/WhyEvolve.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <SiteHeader />
  <SectionRail />
  <main id="main-content" data-page-motion>
    <Hero />
    <WhyEvolve />
    <EvolutionFormulation />
    <EvolutionSpectrum />
    <Architecture />
    <Results />
    <Resources />
  </main>
  <PageMotion />
</BaseLayout>
