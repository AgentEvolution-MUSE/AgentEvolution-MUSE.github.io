---
import GitHubMark from './GitHubMark.astro';
import { resources } from '../data/site';
---

<section id="resources" class="section-band resources-band" aria-labelledby="resources-title">
  <div class="container section-intro">
    <h2 id="resources-title" class="section-heading">Resources</h2>
  </div>

  <div class="container resource-list">
    {resources.map((resource) => (
      resource.status === 'available' && resource.href ? (
        <a class="resource-row" href={resource.href} target="_blank" rel="noopener noreferrer">
          <span><strong>{resource.label}</strong><small>{resource.description}</small></span>
          <span class="resource-state resource-github-link"><GitHubMark />GitHub ↗</span>
        </a>
      ) : (
        <div class="resource-row" aria-disabled="true">
          <span><strong>{resource.label}</strong><small>{resource.description}</small></span>
          <span class="resource-state">Coming Soon</span>
        </div>
      )
    ))}
  </div>
</section>
