---
import ResultTable from './ResultTable.astro';
import data from '../data/result-tables.json';
import '../styles/result-overviews.css';
const rows=data.overall;
const x=(v:number)=>80+(v-28)/30*850;
const y=(v:number)=>70+(21-v)/5*270;
const labels=[[95,159],[133,40],[277,60],[300,125],[405,263],[555,145],[790,255]];
const ends=[[136,140],[170,48],[264,64],[286,117],[470,246],[585,154],[835,263]];
const color=(i:number)=>i===6?'#527fa4':i===5?'#c7986b':i===4?'#7c9c91':'#9ba7b4';
---
<div class="result-overview" data-result-overview="overall">
 <figure class="result-overview-figure">
  <figcaption><span class="overview-caption-actions"><button type="button" data-overview-reset hidden>Show all</button></span></figcaption>
  <div class="result-overview-scroll" tabindex="0" role="region" aria-label="Success versus execution steps; scroll horizontally on narrow screens">
   <svg class="result-tradeoff" viewBox="0 0 1000 410" role="group" aria-labelledby="tradeoff-title tradeoff-description">
    <title id="tradeoff-title">Success rate and execution steps across seven methods</title>
    <desc id="tradeoff-description">Horizontal axis: best success rate, from 28 to 58 percent. Vertical axis: average execution steps, from 16 to 21. MUSE has the highest success rate and lowest step count. Select a method to highlight its values and table row.</desc>
    {[16,17,18,19,20,21].map(v=><g><line class="overview-grid" x1="80" x2="930" y1={y(v)} y2={y(v)}/><text class="overview-tick" x="61" y={y(v)+5} text-anchor="end">{v}</text></g>)}
    {[30,35,40,45,50,55].map(v=><g><line class="overview-grid" x1={x(v)} x2={x(v)} y1="70" y2="340"/><text class="overview-tick" x={x(v)} y="366" text-anchor="middle">{v}</text></g>)}
    <text class="overview-axis" transform="translate(22 205) rotate(-90)" text-anchor="middle">Average execution steps ↓</text>
    <text class="overview-axis" x="505" y="402" text-anchor="middle">Best success rate (%) →</text>
    <path data-tradeoff-guide class="overview-guide" d="" visibility="hidden" aria-hidden="true"/>
    {rows.map((r,i)=><g class="overview-method" data-overview-row={i} tabindex="0" role="button" aria-label={`${r.name}: ${r.values[0]} percent success, ${r.values[2]} average steps`}>
     <path d={`M${x(r.values[0]!)} ${y(r.values[2]!)} L${ends[i][0]} ${ends[i][1]}`} fill="none" stroke={color(i)} stroke-width="1.2"/>
     <circle class="overview-hit" cx={x(r.values[0]!)} cy={y(r.values[2]!)} r="23" fill="transparent"/>
     <circle class="overview-halo" cx={x(r.values[0]!)} cy={y(r.values[2]!)} r="16" fill={color(i)}/>
     <circle cx={x(r.values[0]!)} cy={y(r.values[2]!)} r={i===6?8:6} fill={color(i)} stroke="white" stroke-width="2"/>
     <text x={labels[i][0]} y={labels[i][1]} class:list={['overview-label',{'overview-ours':i===6}]}>{r.name}</text>
    </g>)}
   </svg>
  </div>
  <label class="overview-mobile-picker">Method<select data-overview-pick disabled>{rows.map((r,i)=><option value={i} selected={i===6}>{r.name}</option>)}</select></label>
  <div class="overview-reading" aria-live="polite" aria-atomic="true"><strong data-overview-name>MUSE</strong><span><b data-overview-sr>54.76%</b> success</span><span><b data-overview-steps>16.91</b> avg. steps</span></div>
 </figure>
 <details class="rq-details overview-full-data" open><summary>All methods and metrics</summary><ResultTable table="overall" /></details>
</div>
<script>
 import data from '../data/result-tables.json';
 const root=document.querySelector<HTMLElement>('[data-result-overview="overall"]');
 if(root){
  const rows=data.overall,guide=root.querySelector<SVGPathElement>('[data-tradeoff-guide]')!,pick=root.querySelector<HTMLSelectElement>('[data-overview-pick]')!;
  const nodes=[...root.querySelectorAll<HTMLElement|SVGElement>('[data-overview-row],[data-result-row]')];
  const index=(n:Element)=>Number(n.getAttribute('data-overview-row')??n.getAttribute('data-result-row'));
  const target=(t:EventTarget|null)=>t instanceof Element?t.closest('[data-overview-row],[data-result-row]'):null;
  let hovered:number|null=null,focused:number|null=null,pinned:number|null=null;
  nodes.filter(n=>n.matches('tr')).forEach(n=>{n.setAttribute('tabindex','0');n.setAttribute('aria-label',`${rows[index(n)].name}: highlight success and execution steps`);});
  function render(){
   const active=hovered??focused??pinned,r=rows[active??6];
   nodes.forEach(n=>{n.toggleAttribute('data-muted',active!==null&&index(n)!==active);n.toggleAttribute('data-highlight',active!==null&&index(n)===active);});
   root!.querySelector('[data-overview-name]')!.textContent=r.name;
   root!.querySelector('[data-overview-sr]')!.textContent=`${r.values[0]!.toFixed(2)}%`;
   root!.querySelector('[data-overview-steps]')!.textContent=r.values[2]!.toFixed(2);
   guide.setAttribute('visibility',active===null?'hidden':'visible');
   guide.setAttribute('d',`M80 ${70+(21-r.values[2]!)/5*270} H${80+(r.values[0]!-28)/30*850} V340`);
   pick.value=String(active??6);
   root!.querySelector<HTMLButtonElement>('[data-overview-reset]')!.hidden=pinned===null;
  }
  root.addEventListener('pointerover',e=>{if(e.pointerType==='touch')return;const n=target(e.target);hovered=n?index(n):null;render();});
  root.addEventListener('pointerout',e=>{if(e.pointerType==='touch')return;const n=target(e.relatedTarget);hovered=n&&root.contains(n)?index(n):null;render();});
  root.addEventListener('focusin',e=>{const n=target(e.target);focused=n?index(n):null;render();});
  root.addEventListener('focusout',e=>{const n=target(e.relatedTarget);focused=n&&root.contains(n)?index(n):null;render();});
  function reveal(i:number){const scroll=root!.querySelector<HTMLElement>('.result-overview-scroll')!,svg=scroll.querySelector('svg')!;if(scroll.scrollWidth>scroll.clientWidth){const px=(80+(rows[i].values[0]!-28)/30*850)*svg.getBoundingClientRect().width/1000;scroll.scrollLeft=px-scroll.clientWidth/2;}}
  root.addEventListener('click',e=>{const n=target(e.target);if(n){pinned=index(n);render();reveal(pinned);}});
  root.querySelector('[data-overview-reset]')!.addEventListener('click',()=>{hovered=focused=pinned=null;render();});
  root.addEventListener('keydown',e=>{
   const n=target(e.target);
   if(e.key==='Escape'){hovered=focused=pinned=null;(document.activeElement as HTMLElement)?.blur();render();}
   if(!n)return;
   if(e.key==='Enter'||e.key===' '){e.preventDefault();pinned=index(n);render();}
   const offset=e.key==='ArrowRight'||e.key==='ArrowDown'?1:e.key==='ArrowLeft'||e.key==='ArrowUp'?-1:0;
   if(offset){e.preventDefault();const next=(index(n)+offset+rows.length)%rows.length;(root.querySelector(`[data-overview-row="${next}"]`) as SVGElement).focus();}
  });
  pick.disabled=false;pick.addEventListener('change',()=>{pinned=Number(pick.value);hovered=focused=null;render();reveal(pinned);});
  render();
 }
</script>
