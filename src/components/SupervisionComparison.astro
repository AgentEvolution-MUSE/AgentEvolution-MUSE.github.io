---
import ResultTable from './ResultTable.astro';
import data from '../data/result-tables.json';
import '../styles/result-overviews.css';
const groups=[...new Set(data.supervision.map(r=>r.group))];
const metrics=[{index:0,label:'Best success rate'},{index:2,label:'Final success rate'}];
const x=(v:number)=>210+(v-30)/30*570;
const signed=(v:number)=>`${v>0?'+':v<0?'−':''}${Math.abs(v).toFixed(2)}`;
---
<div class="result-overview" data-supervision-overview>
 <figure class="result-overview-figure">
  <div class="supervision-legend"><span><i class="legend-oracle" aria-hidden="true"></i>Oracle</span><span><i class="legend-synthetic" aria-hidden="true"></i>Oracle + synthetic</span></div>
  <div class="supervision-switch" role="group" aria-label="Success metric" hidden>{metrics.map((m,i)=><button type="button" data-supervision-metric={i} aria-pressed={i===0}>{m.label}</button>)}</div>
  {metrics.map((m,mi)=><div data-supervision-panel={mi}>
   <h4 class="supervision-fallback-title">{m.label}</h4>
   <div class="result-overview-scroll" tabindex="0" role="region" aria-label={`${m.label} with and without synthetic tasks; scroll horizontally on narrow screens`}>
    <svg viewBox="0 0 1000 350" role="group" aria-labelledby={`supervision-plot-title-${mi}`}>
     <title id={`supervision-plot-title-${mi}`}>{m.label} by component configuration and oracle availability</title>
     {[30,35,40,45,50,55,60].map(v=><g><line class="overview-grid" x1={x(v)} x2={x(v)} y1="45" y2="292"/><text class="overview-tick" x={x(v)} y="322" text-anchor="middle">{v}</text></g>)}
     <text class="overview-axis" x="210" y="24">Success rate (%)</text><text class="overview-axis" x="968" y="24" text-anchor="end">Change (pp)</text>
     <line class="overview-divider" x1="0" x2="980" y1="177" y2="177"/>
     {groups.map((g,gi)=>{
      const pair=data.supervision.filter(r=>r.group===g&&r.detail==='With prefix potential');
      const a=pair[0].values[m.index],b=pair[1].values[m.index],y=78+gi*65;
      return <g class="supervision-pair" data-supervision-group={g} tabindex="0" role="button" aria-label={`${g}, ${m.label}: oracle ${a} percent, oracle plus synthetic ${b} percent, change ${signed(b-a)} percentage points`}>
       <rect x="0" y={y-27} width="980" height="58" fill="transparent"/>
       <text class="overview-label" x="8" y={y-2}>{g.split(' · ')[0]}</text><text class="overview-tick" x="8" y={y+19}>{g.split(' · ')[1]}</text>
       <line x1={x(a)} x2={x(b)} y1={y} y2={y} stroke={b>=a?'#8aaaba':'#ccab8c'} stroke-width="4"/>
       <circle cx={x(a)} cy={y} r="7" fill="white" stroke="#8796a5" stroke-width="2.5"/>
       <circle cx={x(b)} cy={y} r="7" fill="#527fa4" stroke="white" stroke-width="1.5"/>
       <text class="overview-value" x={x(a)} y={y-16} text-anchor="middle">{a.toFixed(2)}</text>
       <text class="overview-value overview-ours" x={x(b)} y={y+25} text-anchor="middle">{b.toFixed(2)}</text>
       <text class="overview-delta" x="968" y={y+6} text-anchor="end" fill={b>=a?'#416f8a':'#9e714c'}>{signed(b-a)}</text>
      </g>;
     })}
    </svg>
   </div>
  </div>)}
 </figure>
 <details class="rq-details overview-full-data" open><summary>All supervision results</summary><ResultTable table="supervision" /></details>
</div>
<script>
 const root=document.querySelector<HTMLElement>('[data-supervision-overview]');
 if(root){
  const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-supervision-metric]')],panels=[...root.querySelectorAll<HTMLElement>('[data-supervision-panel]')];
  let selected=0,pinned:string|null=null;
  root.dataset.overviewReady='';root.querySelector<HTMLElement>('.supervision-switch')!.hidden=false;
  const highlight=(group:string|null)=>{
   root.querySelectorAll('[data-supervision-group]').forEach(n=>{n.toggleAttribute('data-muted',group!==null&&n.getAttribute('data-supervision-group')!==group);n.toggleAttribute('data-highlight',group!==null&&n.getAttribute('data-supervision-group')===group);});
  };
  function render(){
   panels.forEach((p,i)=>p.hidden=i!==selected);buttons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===selected)));
   highlight(pinned);
  }
  function choose(group:string){pinned=pinned===group?null:group;highlight(pinned);}
  buttons.forEach((b,i)=>b.addEventListener('click',()=>{selected=i;render();}));
  root.querySelectorAll<SVGElement>('[data-supervision-group]').forEach(n=>{
   const group=n.dataset.supervisionGroup!;
   n.addEventListener('pointerenter',e=>{if(e.pointerType!=='touch')highlight(group);});
   n.addEventListener('pointerleave',()=>highlight(pinned));
   n.addEventListener('focus',()=>highlight(group));n.addEventListener('blur',()=>highlight(pinned));
   n.addEventListener('click',()=>choose(group));
   n.addEventListener('keydown',e=>{
    if(e.key==='Enter'||e.key===' '){e.preventDefault();choose(group);}
    const offset=e.key==='ArrowDown'?1:e.key==='ArrowUp'?-1:0;
    if(offset){e.preventDefault();const siblings=[...panels[selected].querySelectorAll<SVGElement>('[data-supervision-group]')];siblings[(siblings.indexOf(n)+offset+siblings.length)%siblings.length].focus();}
   });
  });
  root.addEventListener('keydown',e=>{if(e.key==='Escape'){pinned=null;(document.activeElement as HTMLElement)?.blur();highlight(null);}});
  render();
 }
</script>
